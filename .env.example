# Environment: development | production
# В development фикстуры автоматически очищают и перезаписывают БД
# В production фикстуры ЗАБЛОКИРОВАНЫ
APP_ENV=development

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/support_panel

# Security
SECRET_KEY=your-secret-key-change-in-production-please-use-strong-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
FRONTEND_URL=http://localhost:5173

# External Services
KNOWLEDGE_BASE_URL=https://qa.example.com
